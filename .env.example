OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Postgres credentials (see docker-compose.yml) — required, no default. Pick your own
# values; they only need to match between the postgres and backend services.
POSTGRES_USER=hr_tool
POSTGRES_PASSWORD=replace-with-a-long-random-string
POSTGRES_DB=hr_tool

# Only needed if you're running the backend directly (not via docker-compose, which
# builds this itself from the POSTGRES_* values above). Shown here at its own default —
# a local Postgres on localhost using the same credentials as above.
# DATABASE_URL=postgresql://hr_tool:hr_tool@localhost:5432/hr_tool

# Where uploaded files (resumes, ID photos, selfies, recordings) are written on disk.
# STORAGE_ROOT=../storage

# JSON array of frontend origins allowed to call this API with credentials — must be
# valid JSON, not a comma-separated list.
# CORS_ORIGINS=["http://localhost:3000"]

# Signs the HR session cookie — required, no default (rotating it logs everyone out).
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Shared secret between the backend and the coturn container (see docker-compose.yml) —
# required, no default. Generate with: openssl rand -hex 32
TURN_SECRET=replace-with-a-long-random-string
TURN_DOMAIN=localhost

# HR accounts are per-user (see the `users` table), created via POST /auth/users once
# someone is logged in — but that needs a first account to exist. Set these to auto-create
# one admin user on startup if none exist yet; unset once real accounts are created.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme

# Optional: local MaxMind GeoLite2-City.mmdb path for the IP-based location signal on
# interviews. The signal is skipped entirely if unset (requires a free MaxMind account).
GEOIP_DB_PATH=

# Optional: Fernet key (generate with `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"`) to encrypt stored ID photos/selfies/recordings at
# rest. Storage behaves exactly as before (plaintext) if unset. Back this up like any other
# credential — losing it makes already-encrypted files permanently unreadable.
STORAGE_ENCRYPTION_KEY=

# How many days raw ID/selfie images are kept before POST /interviews/cleanup-expired-media
# deletes them (keeping only the verdict/confidence).
IDENTITY_MEDIA_RETENTION_DAYS=90

# Google/Microsoft sign-in for HR (Phase 4) — blank until you create these yourself
# (Google Cloud OAuth client / Microsoft Entra app registration); sign-in buttons simply
# won't work until set. Only ever a way for an EXISTING HR user to log in, never a way to
# self-register — see api/v1/oauth.py.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Where the OAuth provider redirects back to after login, and where the frontend lives —
# both must match wherever this is actually deployed (and OAUTH_REDIRECT_BASE_URL must
# match what's registered with the provider) or sign-in will fail. Shown here at their
# own local-dev defaults.
# OAUTH_REDIRECT_BASE_URL=http://localhost:8000/api/v1
# FRONTEND_BASE_URL=http://localhost:3000
